# --- broker (packages/broker) ---

# From api.slack.com/apps after creating the app from slack-app-manifest.yaml:
# OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Basic Information -> App-Level Tokens -> create one with scope connections:write (xapp-...)
SLACK_APP_TOKEN=

# Protects the /admin dashboard (HTTP basic auth, username "admin").
ADMIN_TOKEN=

# Slack user IDs (comma-separated) that bypass per-host ACLs. Yours goes here.
ADMIN_SLACK_IDS=

# Optional overrides
# PORT=8787
# DB_PATH=./workspace-agent.db
# DEFAULT_DAILY_LIMIT=50
# ASKER_RATE_PER_MINUTE=6
# QUERY_TIMEOUT_MS=360000
# Channel ID to post a one-line breadcrumb when someone queries via DM:
# BREADCRUMB_CHANNEL=C0123456789
